# PawsFinder — Environment Variables (copy to .env and fill in values)
# Set this to your live production domain (no trailing slash)
VITE_SITE_URL=https://pawsfinder.org
VITE_APP_NAME=PawsFinder

# Supabase Realtime Database (Get these from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
